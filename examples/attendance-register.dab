' Tous les jours du lundi au vendredi seront produits automatiquement entre
' Period.Start et Period.End. Un samedi ou un dimanche n'est ajouté que si une
' activité existe dans Days pour cette date.
'
' Statuts reconnus : Present / Absent / Late, ainsi que P / A / R.
' Late = true peut également accompagner un statut Present.
{Days
  [
    Date = "2026-01-05"
    Morning = "Present"
    Afternoon = "Late"
    {Activities
      [
        Name = "Cours de programmation"
        Begin = "09:00"
        End = "13:00"
        Status = "Present"
      ],
      [
        Name = "Soutenance"
        Begin = "14:00"
        End = "17:00"
        Status = "Late"
      ]
    }
  ],
  [
    Date = "2026-01-06"
    Morning = "Absent"
    Afternoon = "Present"
  ],
  [
    Date = "2026-01-10"
    {Activities
      [
        Name = "Hackathon"
        Begin = "10:00"
        End = "18:00"
        Status = "Present"
      ]
    }
  ]
}
